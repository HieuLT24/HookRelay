generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EndpointStatus {
  ACTIVE
  PAUSED
  DISABLED
}

enum DeliveryStatus {
  PENDING
  IN_FLIGHT
  RETRYING
  SUCCEEDED
  FAILED
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique
  passwordHash  String         @map("password_hash")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  apiKeys       ApiKey[]
  endpoints     Endpoint[]
  events        Event[]

  @@map("users")
}

model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  name       String?
  prefix     String
  keyHash    String    @map("key_hash")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("api_keys")
}

model Endpoint {
  id                  String         @id @default(uuid()) @db.Uuid
  userId              String         @map("user_id") @db.Uuid
  url                 String
  description         String?
  eventTypes          String[]       @map("event_types")
  signingSecret       String         @map("signing_secret")
  status              EndpointStatus @default(ACTIVE)
  consecutiveFailures Int            @default(0) @map("consecutive_failures")
  pausedAt            DateTime?      @map("paused_at")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries          Delivery[]

  @@index([userId, status])
  @@map("endpoints")
}

model Event {
  id              String     @id @default(uuid()) @db.Uuid
  userId          String     @map("user_id") @db.Uuid
  type            String
  payload         Json
  idempotencyKey  String?    @map("idempotency_key")
  requestHash     String?    @map("request_hash")
  createdAt       DateTime   @default(now()) @map("created_at")
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries      Delivery[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@map("events")
}

model Delivery {
  id              String           @id @default(uuid()) @db.Uuid
  eventId         String           @map("event_id") @db.Uuid
  endpointId      String           @map("endpoint_id") @db.Uuid
  status          DeliveryStatus   @default(PENDING)
  attemptCount    Int              @default(0) @map("attempt_count")
  nextAttemptAt   DateTime         @default(now()) @map("next_attempt_at")
  lockedUntil     DateTime?        @map("locked_until")
  lastStatusCode  Int?             @map("last_status_code")
  lastError       String?          @map("last_error")
  succeededAt     DateTime?        @map("succeeded_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  event           Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  endpoint        Endpoint         @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  attempts        DeliveryAttempt[]

  @@unique([eventId, endpointId])
  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
  @@map("deliveries")
}

model DeliveryAttempt {
  id              String   @id @default(uuid()) @db.Uuid
  deliveryId      String   @map("delivery_id") @db.Uuid
  attemptNumber   Int      @map("attempt_number")
  startedAt       DateTime @default(now()) @map("started_at")
  durationMs      Int?     @map("duration_ms")
  statusCode      Int?     @map("status_code")
  error           String?
  responseSnippet String?  @map("response_snippet")
  delivery        Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@unique([deliveryId, attemptNumber])
  @@map("delivery_attempts")
}
